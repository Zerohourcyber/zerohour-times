# The ZeroHour Times — copy to .env and fill in. `./scripts/setup.sh` does this for you.
# .env is gitignored. Never commit it.

# ---- JobSync secrets (generated for you by setup.sh) ------------------------
# Both must stay the same for the life of your data.
#   AUTH_SECRET     if this changes, you are logged out of JobSync.
#   ENCRYPTION_KEY  encrypts the AI provider keys JobSync stores. If you lose
#                   it, those keys cannot be recovered — by design. Keep a copy
#                   somewhere safe before you enter any API key.
AUTH_SECRET=
ENCRYPTION_KEY=

# ---- Connecting The ZeroHour Times to JobSync -------------------------------
# Mint this AFTER first start: open JobSync -> Settings -> MCP -> create a
# token. Give it the scope `jobs:write` and nothing else, and set an expiry.
# Leave blank to run in demo mode with the bundled sample data.
JOBSYNC_MCP_TOKEN=

# Where JobSync is. The compose file sets this to the container name for you, so
# you only need it if you run The ZeroHour Times outside Docker, or point it at
# a JobSync you already have running somewhere else.
# JOBSYNC_URL=http://jobsync:3737

# ---- AI provider ------------------------------------------------------------
# Used for match assessments and company research. Leave blank and those stages
# are skipped; discovery and the dashboard still work.
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint works (LocalAI, Ollama's compat layer, etc.)
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Behaviour ---------------------------------------------------------------
# Any IANA timezone. Used for scheduling and every date you see.
ZHT_TZ=UTC
# Local time the daily pipeline runs: discover -> match -> research -> dashboard.
ZHT_RUN_AT=07:10
# Run once at container start too, so you see results without waiting a day.
ZHT_RUN_ON_START=1

# ---- Ports (bound to 127.0.0.1 by the compose file) --------------------------
JOBSYNC_PORT=3737
ZHT_DASHBOARD_PORT=8099
# If you reach JobSync at something other than localhost, set this to match, or
# sign-in will fail.
JOBSYNC_PUBLIC_URL=http://localhost:3737

# ---- Spending ----------------------------------------------------------------
# Hard daily cap shared by matching and research, enforced in code and keyed on
# your local date. Typical cost is roughly $0.02 per assessment and $0.05 per
# researched company. Override the per-1K token prices in config.json.
# (Set the cap itself in config.json -> matching.max_usd_per_day)

# ---- Advanced -----------------------------------------------------------------
# JobSync allows 100 MCP calls per hour per token. Discovery runs first and
# shares that ceiling with matching, so it is capped below half to leave room.
# ZHT_MCP_CALL_BUDGET=45
# Only change this if you understand the exposure: the dashboard is read-only
# but UNAUTHENTICATED, and shows your assessments and profile-derived analysis.
# ZHT_DASHBOARD_BIND=0.0.0.0
